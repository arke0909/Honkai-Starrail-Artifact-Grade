@page "/"
@inject HttpClient Http

<PageTitle>개척자의 유물 감정소</PageTitle>

<section class="hero" aria-labelledby="page-title">
    <div>
        <p class="eyebrow">HONKAI: STAR RAIL · RELIC SCORER</p>
        <h1 id="page-title">이 유물, 이 캐릭터에게 정말 좋은 걸까?</h1>
        <p class="hero-copy">
            UID 또는 Scanner JSON으로 유물을 불러오면 장착 캐릭터의 HP·공격력·방어력 스케일과
            치명타·속도·격파·효과 명중 등 12개 옵션 가중치를 자동 적용합니다.
        </p>
    </div>
    <aside class="formula-note">
        <span>계산 기준</span>
        <strong>주옵션 50점 + 부옵션 50점 기준</strong>
        <small>@CharacterGradeCatalog.Summary</small>
    </aside>
</section>

<section class="panel import-panel" aria-labelledby="import-title">
    <div class="panel-heading">
        <div>
            <span class="step">AUTO IMPORT</span>
            <h2 id="import-title">유물 자동 불러오기</h2>
        </div>
        <span class="optional">로그인 정보·쿠키 수집 없음</span>
    </div>

    <div class="import-grid">
        <div class="import-option">
            <div>
                <strong>UID 공개 프로필</strong>
                <p>게임 프로필에 공개한 캐릭터의 장착 유물을 바로 가져옵니다.</p>
            </div>
            <div class="import-action">
                <label class="sr-only" for="uid-input">스타레일 UID</label>
                <input id="uid-input" inputmode="numeric" maxlength="9" placeholder="UID 숫자 9자리" disabled="@IsImportBusy"
                       @bind="_uid" @bind:event="oninput" />
                <button class="secondary-button" type="button" disabled="@IsImportBusy" @onclick="ImportUidAsync">
                    @(_isImporting ? "불러오는 중..." : "UID 불러오기")
                </button>
            </div>
        </div>

        <div class="import-option">
            <div>
                <strong>전체 인벤토리 JSON</strong>
                <p>HSR Scanner 또는 호환 도구가 만든 버전 4 JSON을 가져옵니다.</p>
            </div>
            <InputFile class="file-input" accept=".json,application/json" disabled="@IsImportBusy"
                       OnChange="ImportScannerJsonAsync" />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_importError))
    {
        <div class="message error-message" role="alert">
            <strong>불러오지 못했습니다.</strong>
            <p>@_importError</p>
        </div>
    }

    @if (_importResult is not null)
    {
        <div class="import-summary">
            <div>
                <strong>@_importResult.Source</strong>
                <span>@(_importResult.PlayerName ?? "로컬 JSON") · 5성 유물 @(_importResult.Relics.Count)개</span>
            </div>
            <span>@(_importResult.FromCache ? "Redis 캐시 사용" : "새로 불러옴")</span>
        </div>

        @if (_importResult.Warnings.Count > 0)
        {
            <div class="message warning-message" role="status">
                <strong>일부 데이터 확인 필요</strong>
                <ul>
                    @foreach (var warning in _importResult.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        @if (_importResult.Relics.Count > 0)
        {
            <div class="character-browser">
                <span class="character-browser-label">캐릭터별 보기</span>
                <div class="character-tabs" role="group" aria-label="유물 장착 캐릭터 선택">
                    @foreach (var group in CharacterGroups)
                    {
                        <button class="@CharacterTabClass(group)" type="button"
                                aria-pressed="@(group.CharacterId == _selectedCharacterId ? "true" : "false")"
                                disabled="@IsImportBusy" @onclick="() => SelectCharacterAsync(group)">
                            <strong>@CharacterDisplayName(group)</strong>
                            <span>@(group.Relics.Count)개</span>
                        </button>
                    }
                </div>
            </div>

            @if (SelectedCharacterGroup is { } selectedCharacter)
            {
                <section class="character-evaluation" aria-labelledby="character-profile-title">
                    <div class="character-evaluation-heading">
                        <div>
                            <span class="profile-eyebrow">AUTO CHARACTER PROFILE</span>
                            <h3 id="character-profile-title">
                                @if (_isBatchScoring)
                                {
                                    <span>캐릭터 전용 기준 확인 중...</span>
                                }
                                else if (_characterProfile is not null)
                                {
                                    <span>@_characterProfile.Archetype</span>
                                }
                                else
                                {
                                    <span>캐릭터 전용 평가 없음</span>
                                }
                            </h3>
                        </div>
                        @if (_characterProfile is not null)
                        {
                            <span class="profile-source">@_characterProfile.Source</span>
                        }
                    </div>

                    @if (_characterProfile is not null)
                    {
                        <p class="profile-description">
                            아래 12개 옵션을 모두 캐릭터별 가중치로 판정합니다. 핵심 옵션만이 아니라
                            유효·보조·비유효 옵션까지 한 번에 비교할 수 있습니다.
                        </p>
                        <div class="stat-weight-grid" aria-label="캐릭터 유효 옵션 전체">
                            @foreach (var statWeight in _characterProfile.StatWeights
                                .OrderByDescending(item => item.Weight)
                                .ThenBy(item => item.Stat))
                            {
                                <div class="stat-weight @PriorityClass(statWeight.Priority)">
                                    <span>@StatsById[statWeight.Stat].Name@(StatsById[statWeight.Stat].Unit)</span>
                                    <b>×@statWeight.Weight.ToString("0.0")</b>
                                    <small>@PriorityLabel(statWeight.Priority)</small>
                                </div>
                            }
                        </div>
                        <p class="profile-caveat">
                            이 점수는 유물 비교용 가중치입니다. 파티 버프, 속도 구간, 치명타 초과와 전투 순환은 별도 확인이 필요합니다.
                        </p>
                        @if (!string.IsNullOrWhiteSpace(_redisWarning))
                        {
                            <p class="profile-storage-status warning" role="status">@_redisWarning</p>
                        }
                        else if (_redisSaved)
                        {
                            <p class="profile-storage-status">✓ 최근 계산 기록을 Redis에 저장했습니다.</p>
                        }
                    }
                    else if (!string.IsNullOrWhiteSpace(_scoreError))
                    {
                        <div class="message warning-message" role="status">
                            <strong>자동 평가는 표시하지 않습니다.</strong>
                            <p>@_scoreError</p>
                        </div>
                    }
                </section>

                <div class="loadout-board">
                    <article class="character-showcase">
                        <span class="showcase-label">CURRENT CHARACTER</span>
                        @if (SelectedCharacterInfo is { } characterInfo
                            && CharacterImageUrl(characterInfo) is { } characterImageUrl)
                        {
                            <img src="@characterImageUrl"
                                 alt="@($"{characterInfo.Name} 캐릭터 전신 이미지")"
                                 @onerror="() => HandleCharacterImageError(characterInfo)" />
                        }
                        else
                        {
                            <div class="character-image-placeholder" role="img"
                                 aria-label="@($"{CharacterDisplayName(selectedCharacter)} 이미지 없음")">
                                <span>이미지 정보 없음</span>
                            </div>
                        }
                        <div class="character-caption">
                            <strong>@CharacterDisplayName(selectedCharacter)</strong>
                            <span>장착 유물 @(selectedCharacter.Relics.Count)개</span>
                            @if (SelectedCharacterInfo is { } displayedCharacter
                                && _characterFallbacksInUse.Contains(displayedCharacter.Id))
                            {
                                <span class="character-image-warning" role="status">
                                    @(_characterImagesUnavailable.Contains(displayedCharacter.Id)
                                        ? "외형과 기본 이미지 로드 실패"
                                        : "외형 이미지 로드 실패 · 기본 이미지 표시 중")
                                </span>
                            }
                        </div>
                    </article>

                    <div class="relic-showcase" aria-label="@($"{CharacterDisplayName(selectedCharacter)} 장착 유물 전체")">
                        @foreach (var relic in selectedCharacter.Relics.OrderBy(item => item.Slot))
                        {
                            var scored = _batchScores.FirstOrDefault(item => item.Relic.Key == relic.Key);
                            var mainStat = scored?.Result.MainStat;
                            <article class="relic-card">
                                <div class="relic-card-media">
                                    @if (relic.ImageUrl is { } relicImageUrl)
                                    {
                                        <img src="@relicImageUrl" alt="@($"{relic.Name} 유물 이미지")" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="relic-image-placeholder" role="img" aria-label="유물 이미지 없음">
                                            <span>◇</span>
                                        </div>
                                    }
                                    <span class="relic-slot">@SlotsById[relic.Slot].Name</span>
                                </div>
                                <div class="relic-card-content">
                                    <strong>@relic.Name</strong>
                                    <span class="relic-set">@relic.SetName · +@relic.Level</span>
                                    <div class="@MainStatClass(mainStat?.Priority)">
                                        <span>주옵션 계수</span>
                                        <b>@RelicMainStatSummary(relic)</b>
                                        @if (mainStat is not null)
                                        {
                                            <small>
                                                @PriorityLabel(mainStat.Priority) · ×@mainStat.Weight.ToString("0.0") · +@mainStat.Score.ToString("0.0")점
                                            </small>
                                        }
                                    </div>

                                    <ul class="relic-substat-list" aria-label="부옵션별 유효도와 기여도">
                                        @foreach (var substat in relic.Substats)
                                        {
                                            var statWeight = _characterProfile?.StatWeights
                                                .FirstOrDefault(item => item.Stat == substat.Stat);
                                            var contribution = scored?.Result.Contributions
                                                .FirstOrDefault(item => item.Stat == substat.Stat);
                                            <li class="@SubstatClass(statWeight?.Priority)">
                                                <span>@StatsById[substat.Stat].Name @substat.Value.ToString("0.##")@StatsById[substat.Stat].Unit</span>
                                                @if (statWeight is not null)
                                                {
                                                    <small>@PriorityLabel(statWeight.Priority) · ×@statWeight.Weight.ToString("0.0")</small>
                                                }
                                                else
                                                {
                                                    <small>평가 기준 없음</small>
                                                }
                                                @if (contribution is not null)
                                                {
                                                    <b>+@contribution.Score.ToString("0.0")</b>
                                                }
                                            </li>
                                        }
                                    </ul>

                                    <div class="relic-card-footer">
                                        @if (scored is { Result.IsValid: true })
                                        {
                                            <b class="relic-score">@scored.Result.Grade · @scored.Result.Score.ToString("0.0")점</b>
                                        }
                                        else if (scored is not null)
                                        {
                                            <b class="relic-score invalid-score">계산 불가</b>
                                        }
                                        else if (_isBatchScoring)
                                        {
                                            <span class="score-pending">자동 계산 중...</span>
                                        }
                                        else
                                        {
                                            <span class="score-pending">캐릭터 전용 평가 없음</span>
                                        }
                                    </div>

                                    @if (scored is { Result.IsValid: false })
                                    {
                                        @foreach (var error in scored.Result.Errors)
                                        {
                                            <span class="relic-error">@error</span>
                                        }
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_importStatus))
        {
            <p class="import-status" role="status">@_importStatus</p>
        }
    }
</section>

@code {
    private const string UnequippedLabel = "미장착";
    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions =
        new(System.Text.Json.JsonSerializerDefaults.Web)
    {
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
    };
    private static readonly IReadOnlyDictionary<RelicStat, CatalogItem<RelicStat>> StatsById =
        RelicCatalog.Substats.ToDictionary(item => item.Value);
    private static readonly IReadOnlyDictionary<RelicSlot, CatalogItem<RelicSlot>> SlotsById =
        RelicCatalog.Slots.ToDictionary(item => item.Value);
    private static readonly IReadOnlyDictionary<RelicMainStat, CatalogItem<RelicMainStat>> MainStatsById =
        RelicCatalog.Slots
            .SelectMany(slot => RelicCatalog.MainStatsFor(slot.Value))
            .DistinctBy(item => item.Value)
            .ToDictionary(item => item.Value);

    private RelicImportResponse? _importResult;
    private CharacterScoringProfile? _characterProfile;
    private readonly List<ScoredImportedRelic> _batchScores = [];
    private readonly HashSet<string> _characterFallbacksInUse = [];
    private readonly HashSet<string> _characterImagesUnavailable = [];
    private string _uid = string.Empty;
    private string? _selectedCharacterId;
    private string? _importError;
    private string? _scoreError;
    private string? _redisWarning;
    private string? _importStatus;
    private bool _isImporting;
    private bool _isBatchScoring;
    private bool _redisSaved;
    private bool IsImportBusy => _isImporting || _isBatchScoring;
    private IReadOnlyList<RelicCharacterGroup> CharacterGroups => _importResult is null
        ? []
        : RelicCharacterGrouping.Create(_importResult.Relics);
    private RelicCharacterGroup? SelectedCharacterGroup => CharacterGroups.FirstOrDefault(group =>
        group.CharacterId == _selectedCharacterId);
    private ImportedCharacter? SelectedCharacterInfo => _importResult?.Characters.FirstOrDefault(character =>
        character.Id == _selectedCharacterId);

    private async Task ImportUidAsync()
    {
        if (IsImportBusy)
        {
            return;
        }

        var uid = _uid.Trim();
        if (uid.Length != 9 || uid.Any(character => !char.IsAsciiDigit(character)))
        {
            _importError = "UID는 숫자 9자리로 입력해 주세요.";
            return;
        }

        _isImporting = true;
        _importError = null;
        _scoreError = null;
        _redisWarning = null;
        _importStatus = null;

        try
        {
            using var response = await Http.GetAsync($"api/import/uid/{uid}");
            if (!response.IsSuccessStatusCode)
            {
                _importError = await ReadApiErrorAsync(response);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<RelicImportResponse>(JsonOptions);
            SetImportResult(result);
            await CalculateSelectedCharacterAsync();
        }
        catch (HttpRequestException)
        {
            _importError = "계산 서버에 연결하지 못했습니다. API 실행 상태를 확인해 주세요.";
        }
        catch (System.Text.Json.JsonException)
        {
            _importError = "공개 프로필 응답 형식을 읽지 못했습니다.";
        }
        finally
        {
            _isImporting = false;
        }
    }

    private async Task ImportScannerJsonAsync(InputFileChangeEventArgs eventArgs)
    {
        if (IsImportBusy)
        {
            return;
        }

        const long maximumFileBytes = 10 * 1024 * 1024;
        _importError = null;
        _scoreError = null;
        _redisWarning = null;
        _importStatus = null;

        if (eventArgs.File.Size > maximumFileBytes)
        {
            _importError = "JSON 파일은 10MB 이하여야 합니다.";
            return;
        }

        _isImporting = true;
        try
        {
            await using var stream = eventArgs.File.OpenReadStream(maximumFileBytes);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            using var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            using var response = await Http.PostAsync("api/import/scanner", content);
            if (!response.IsSuccessStatusCode)
            {
                _importError = await ReadApiErrorAsync(response);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<RelicImportResponse>(JsonOptions);
            SetImportResult(result);
            await CalculateSelectedCharacterAsync();
        }
        catch (IOException)
        {
            _importError = "선택한 JSON 파일을 읽지 못했습니다.";
        }
        catch (HttpRequestException)
        {
            _importError = "계산 서버에 연결하지 못했습니다. API 실행 상태를 확인해 주세요.";
        }
        catch (System.Text.Json.JsonException)
        {
            _importError = "HSR Scanner JSON 응답 형식을 읽지 못했습니다.";
        }
        finally
        {
            _isImporting = false;
        }
    }

    private void SetImportResult(RelicImportResponse? result)
    {
        if (result is null)
        {
            _importError = "불러오기 결과를 읽지 못했습니다.";
            return;
        }

        _importResult = result;
        _characterFallbacksInUse.Clear();
        _characterImagesUnavailable.Clear();
        var firstCharacter = CharacterGroups.FirstOrDefault();
        _selectedCharacterId = firstCharacter?.CharacterId;
        _characterProfile = null;
        _batchScores.Clear();
        _importStatus = result.Relics.Count > 0
            ? $"5성 유물 {result.Relics.Count}개를 불러왔습니다. 선택 캐릭터 기준으로 자동 평가합니다."
            : "가져올 수 있는 5성 유물이 없습니다.";
    }

    private async Task SelectCharacterAsync(RelicCharacterGroup group)
    {
        if (IsImportBusy)
        {
            return;
        }

        _selectedCharacterId = group.CharacterId;
        await CalculateSelectedCharacterAsync();
    }

    private async Task CalculateSelectedCharacterAsync()
    {
        _characterProfile = null;
        _batchScores.Clear();
        _scoreError = null;
        _redisWarning = null;
        _redisSaved = false;

        if (SelectedCharacterGroup is not { } group)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(group.CharacterId))
        {
            _scoreError = "미장착 유물은 기준 캐릭터가 없어 점수를 임의로 계산하지 않습니다.";
            return;
        }

        _isBatchScoring = true;
        try
        {
            foreach (var relicChunk in group.Relics.Chunk(300))
            {
                var request = new CharacterRelicBatchScoreRequest(
                    group.CharacterId,
                    CharacterDisplayName(group),
                    relicChunk);
                using var response = await Http.PostAsJsonAsync(
                    "api/scores/character-batch",
                    request,
                    JsonOptions);
                if (!response.IsSuccessStatusCode)
                {
                    _scoreError = await ReadApiErrorAsync(response);
                    _batchScores.Clear();
                    return;
                }

                var result = await response.Content.ReadFromJsonAsync<CharacterRelicBatchScoreResponse>(JsonOptions);
                if (result is null)
                {
                    _scoreError = "캐릭터별 계산 결과를 읽지 못했습니다.";
                    _batchScores.Clear();
                    return;
                }

                _characterProfile = result.Profile;
                _batchScores.AddRange(result.Scores);
                _redisSaved |= result.RedisSaved;
                _redisWarning ??= result.Warning;
            }

            _importStatus = $"{CharacterDisplayName(group)}의 {_characterProfile!.Archetype} 기준으로 "
                + $"유물 {_batchScores.Count}개를 자동 계산했습니다.";
        }
        catch (HttpRequestException)
        {
            _scoreError = "캐릭터별 계산 서버에 연결하지 못했습니다.";
            _batchScores.Clear();
        }
        catch (System.Text.Json.JsonException)
        {
            _scoreError = "캐릭터별 계산 응답 형식을 읽지 못했습니다.";
            _batchScores.Clear();
        }
        finally
        {
            _isBatchScoring = false;
        }
    }

    private string? CharacterImageUrl(ImportedCharacter character)
    {
        if (_characterImagesUnavailable.Contains(character.Id))
        {
            return null;
        }

        return _characterFallbacksInUse.Contains(character.Id)
            ? character.FallbackImageUrl
            : character.ImageUrl;
    }

    private void HandleCharacterImageError(ImportedCharacter character)
    {
        if (character.FallbackImageUrl is not null
            && _characterFallbacksInUse.Add(character.Id))
        {
            return;
        }

        _characterImagesUnavailable.Add(character.Id);
    }

    private string CharacterTabClass(RelicCharacterGroup group) =>
        group.CharacterId == _selectedCharacterId
            ? "character-tab active"
            : "character-tab";

    private static string CharacterDisplayName(RelicCharacterGroup group) =>
        group.CharacterName ?? UnequippedLabel;

    private static string PriorityLabel(CharacterStatPriority priority) => priority switch
    {
        CharacterStatPriority.Core => "핵심",
        CharacterStatPriority.Useful => "유효",
        CharacterStatPriority.Secondary => "보조",
        _ => "비유효"
    };

    private static string PriorityClass(CharacterStatPriority priority) =>
        $"priority-{priority.ToString().ToLowerInvariant()}";

    private static string SubstatClass(CharacterStatPriority? priority) => priority.HasValue
        ? $"relic-substat {PriorityClass(priority.Value)}"
        : "relic-substat";

    private static string MainStatClass(CharacterStatPriority? priority) => priority.HasValue
        ? $"main-stat-value {PriorityClass(priority.Value)}"
        : "main-stat-value";

    private static async Task<string> ReadApiErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var error = await response.Content.ReadFromJsonAsync<ApiError>(JsonOptions);
            return string.IsNullOrWhiteSpace(error?.Message)
                ? $"서버가 {(int)response.StatusCode} 오류를 반환했습니다."
                : error.Message;
        }
        catch (System.Text.Json.JsonException)
        {
            return $"서버가 {(int)response.StatusCode} 오류를 반환했습니다.";
        }
    }

    private static string RelicMainStatSummary(ImportedRelic relic)
    {
        var mainStat = MainStatsById[relic.MainStat];
        return relic.MainStatValue.HasValue
            ? $"{mainStat.Name} {relic.MainStatValue.Value:0.##}{mainStat.Unit}"
            : $"{mainStat.Name} · 수치 정보 없음";
    }

    private sealed record ApiError(string Message);
}
