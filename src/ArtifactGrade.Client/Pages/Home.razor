@page "/"
@inject HttpClient Http
@inject IJSRuntime JavaScript

<PageTitle>개척자의 유물 감정소</PageTitle>

<section class="hero" aria-labelledby="page-title">
    <div>
        <p class="eyebrow">HONKAI: STAR RAIL · RELIC SCORER</p>
        <h1 id="page-title">이 유물, 정말 강화할 가치가 있을까?</h1>
        <p class="hero-copy">
            5성 유물의 부옵션을 입력하면 최고 증가량 대비 효율과 캐릭터 육성 방향을 반영해
            점수와 등급을 계산합니다.
        </p>
    </div>
    <aside class="formula-note">
        <span>계산 기준</span>
        <strong>유효 증가량 × 가중치 × 10</strong>
        <small>점수 근거를 스탯별로 모두 공개합니다.</small>
    </aside>
</section>

<section class="panel import-panel" aria-labelledby="import-title">
    <div class="panel-heading">
        <div>
            <span class="step">AUTO IMPORT</span>
            <h2 id="import-title">유물 자동 불러오기</h2>
        </div>
        <span class="optional">로그인 정보·쿠키 수집 없음</span>
    </div>

    <div class="import-grid">
        <div class="import-option">
            <div>
                <strong>UID 공개 프로필</strong>
                <p>게임 프로필에 공개한 캐릭터의 장착 유물을 바로 가져옵니다.</p>
            </div>
            <div class="import-action">
                <label class="sr-only" for="uid-input">스타레일 UID</label>
                <input id="uid-input" inputmode="numeric" maxlength="9" placeholder="UID 숫자 9자리" disabled="@IsImportBusy"
                       @bind="_uid" @bind:event="oninput" />
                <button class="secondary-button" type="button" disabled="@IsImportBusy" @onclick="ImportUidAsync">
                    UID 불러오기
                </button>
            </div>
        </div>

        <div class="import-option">
            <div>
                <strong>전체 인벤토리 JSON</strong>
                <p>HSR Scanner 또는 호환 도구가 만든 버전 4 JSON을 가져옵니다.</p>
            </div>
            <InputFile class="file-input" accept=".json,application/json" disabled="@IsImportBusy"
                       OnChange="ImportScannerJsonAsync" />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_importError))
    {
        <div class="message error-message" role="alert">
            <strong>불러오지 못했습니다.</strong>
            <p>@_importError</p>
        </div>
    }

    @if (_importResult is not null)
    {
        <div class="import-summary">
            <div>
                <strong>@_importResult.Source</strong>
                <span>@(_importResult.PlayerName ?? "로컬 JSON") · 5성 유물 @(_importResult.Relics.Count)개</span>
            </div>
            <span>@(_importResult.FromCache ? "Redis 캐시 사용" : "새로 불러옴")</span>
        </div>

        @if (_importResult.Warnings.Count > 0)
        {
            <div class="message warning-message" role="status">
                <strong>일부 데이터 확인 필요</strong>
                <ul>
                    @foreach (var warning in _importResult.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        @if (_importResult.Relics.Count > 0)
        {
            <div class="import-controls">
                <label class="field">
                    <span>가져온 유물 선택</span>
                    <select @bind="_selectedRelicKey" disabled="@IsImportBusy">
                        @foreach (var relic in _importResult.Relics)
                        {
                            <option value="@relic.Key">@RelicLabel(relic)</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span>일괄 평가 프로필</span>
                    <select @bind="_input.Profile" disabled="@IsImportBusy">
                        @foreach (var profile in RelicCatalog.Profiles)
                        {
                            <option value="@profile.Value">@profile.Name</option>
                        }
                    </select>
                </label>
                <button class="secondary-button" type="button" disabled="@IsImportBusy" @onclick="ApplySelectedRelic">선택 유물 적용</button>
                <button class="primary-button compact-button" type="button" disabled="@IsImportBusy"
                        @onclick="CalculateImportedRelicsAsync">
                    @(_isBatchScoring ? "계산 중..." : "전체 점수 계산")
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_importStatus))
        {
            <p class="import-status" role="status">@_importStatus</p>
        }

        @if (_batchScores.Count > 0)
        {
            <div class="batch-results" aria-label="가져온 유물 점수">
                @foreach (var scored in _batchScores)
                {
                    <div class="batch-row">
                        <div>
                            <strong>@RelicLabel(scored.Relic)</strong>
                            <span>@SubstatSummary(scored.Relic)</span>
                        </div>
                        <div class="batch-score">
                            @if (scored.Result.IsValid)
                            {
                                <b>@scored.Result.Grade · @scored.Result.Score.ToString("0.0")점</b>
                            }
                            else
                            {
                                <b class="invalid-score">계산 불가</b>
                                @foreach (var error in scored.Result.Errors)
                                {
                                    <span class="batch-error">@error</span>
                                }
                            }
                        </div>
                        <button class="text-button" type="button" @onclick="() => ApplyImportedRelic(scored.Relic)">입력칸에 적용</button>
                    </div>
                }
            </div>
        }
    }
</section>

<div class="calculator-grid">
    <section class="panel input-panel" aria-labelledby="input-title">
        <div class="panel-heading">
            <div>
                <span class="step">STEP 01</span>
                <h2 id="input-title">유물 정보 입력</h2>
            </div>
            <button class="text-button" type="button" disabled="@_isBatchScoring" @onclick="ResetAsync">전체 초기화</button>
        </div>

        <div class="field-grid">
            <label class="field">
                <span>평가 프로필</span>
                <select @bind="_input.Profile" disabled="@_isBatchScoring">
                    @foreach (var profile in RelicCatalog.Profiles)
                    {
                        <option value="@profile.Value">@profile.Name</option>
                    }
                </select>
                <small>장착할 캐릭터의 주요 성장 방식과 가까운 항목을 선택하세요.</small>
            </label>

            <label class="field">
                <span>강화 단계</span>
                <select @bind="_input.Level">
                    @for (var level = 0; level <= 15; level++)
                    {
                        <option value="@level">+@level</option>
                    }
                </select>
                <small>현재 유물 화면에 표시된 강화 단계를 선택하세요.</small>
            </label>

            <label class="field">
                <span>유물 부위</span>
                <select @bind="_input.Slot" @bind:after="UpdateMainStatOptions">
                    @foreach (var slot in RelicCatalog.Slots)
                    {
                        <option value="@slot.Value">@slot.Name</option>
                    }
                </select>
                <small>장착 위치에 따라 선택 가능한 주옵션이 달라집니다.</small>
            </label>

            <label class="field">
                <span>주옵션</span>
                <select @bind="_input.MainStat">
                    @foreach (var mainStat in RelicCatalog.MainStatsFor(_input.Slot))
                    {
                        <option value="@mainStat.Value">@mainStat.Name@(mainStat.Unit)</option>
                    }
                </select>
                <small>주옵션은 부옵션 점수와 분리하여 유물 정보를 검증합니다.</small>
            </label>
        </div>

        <div class="substat-header">
            <div>
                <span class="step">STEP 02</span>
                <h3>부옵션</h3>
            </div>
            <span class="optional">1~4개 입력</span>
        </div>

        <div class="substat-list">
            @for (var index = 0; index < _input.Substats.Count; index++)
            {
                var row = _input.Substats[index];
                <div class="substat-row">
                    <span class="row-number">@(index + 1)</span>
                    <label>
                        <span class="sr-only">부옵션 @(index + 1) 종류</span>
                        <select @bind="row.Stat">
                            @foreach (var stat in RelicCatalog.Substats)
                            {
                                <option value="@stat.Value">@stat.Name@(stat.Unit)</option>
                            }
                        </select>
                    </label>
                    <label class="value-field">
                        <span class="sr-only">부옵션 @(index + 1) 수치</span>
                        <input type="number" min="0" step="0.01" placeholder="수치" @bind="row.Value" @bind:event="oninput" />
                        <span>@StatsById[row.Stat].Unit</span>
                    </label>
                </div>
            }
        </div>

        @if (_messages.Count > 0)
        {
            <div class="message error-message" role="alert">
                <strong>입력 내용을 확인해 주세요.</strong>
                <ul>
                    @foreach (var message in _messages)
                    {
                        <li>@message</li>
                    }
                </ul>
            </div>
        }

        <button class="primary-button" type="button" disabled="@_isCalculating" @onclick="CalculateAsync">
            @if (_isCalculating)
            {
                <span>계산 중...</span>
            }
            else
            {
                <span>유물 점수 계산하기</span>
                <span aria-hidden="true">→</span>
            }
        </button>
    </section>

    <section class="panel result-panel" aria-labelledby="result-title">
        <div class="panel-heading">
            <div>
                <span class="step">RESULT</span>
                <h2 id="result-title">감정 결과</h2>
            </div>
            @if (_submission is not null)
            {
                <button class="text-button" type="button" @onclick="CopyResultAsync">결과 복사</button>
            }
        </div>

        @if (_submission is null)
        {
            <div class="empty-result">
                <div class="relic-orbit" aria-hidden="true"><span>✦</span></div>
                <h3>아직 감정할 유물이 없습니다.</h3>
                <p>왼쪽에서 프로필과 부옵션을 입력하면 결과가 여기에 표시됩니다.</p>
            </div>
        }
        else
        {
            <div class="score-card grade-@_submission.Result.Grade.ToLowerInvariant()">
                <div class="grade-block">
                    <span>유물 등급</span>
                    <strong>@_submission.Result.Grade</strong>
                </div>
                <div class="score-block">
                    <span>@ProfilesById[_resultProfile!.Value].Name 프로필</span>
                    <strong>@_submission.Result.Score.ToString("0.0")<small>점</small></strong>
                </div>
            </div>

            <div class="grade-scale" aria-label="등급 기준">
                <span>C</span><span>B 35</span><span>A 45</span><span>S 55</span><span>SS 65</span><span>SSS 75</span>
            </div>

            <div class="breakdown">
                <div class="substat-header">
                    <h3>스탯별 기여도</h3>
                    <span class="optional">가중치 적용</span>
                </div>
                @foreach (var contribution in _submission.Result.Contributions)
                {
                    <div class="contribution-row">
                        <div>
                            <strong>@StatsById[contribution.Stat].Name</strong>
                            <small>가중치 ×@contribution.Weight.ToString("0.0")</small>
                        </div>
                        <span>+@contribution.Score.ToString("0.0")</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_submission.Warning))
            {
                <div class="message warning-message" role="status">
                    <strong>Redis 저장 알림</strong>
                    <p>@_submission.Warning</p>
                </div>
            }
            else if (_submission.RedisSaved)
            {
                <p class="saved-message">✓ 최근 계산 기록이 Redis에 저장되었습니다.</p>
            }

            @if (!string.IsNullOrWhiteSpace(_copyMessage))
            {
                <p class="copy-message" role="status">@_copyMessage</p>
            }
        }
    </section>
</div>

<section class="guide-strip" aria-label="사용 안내">
    <article><span>01</span><div><strong>프로필 선택</strong><p>캐릭터의 주요 성장 방식을 고릅니다.</p></div></article>
    <article><span>02</span><div><strong>수치 그대로 입력</strong><p>% 기호 없이 게임에 보이는 숫자만 적습니다.</p></div></article>
    <article><span>03</span><div><strong>근거까지 비교</strong><p>총점뿐 아니라 어떤 스탯이 기여했는지 확인합니다.</p></div></article>
</section>

@code {
    private const string StorageKey = "artifact-grade:input";
    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions =
        new(System.Text.Json.JsonSerializerDefaults.Web)
        {
            Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
        };
    private static readonly IReadOnlyDictionary<RelicStat, CatalogItem<RelicStat>> StatsById =
        RelicCatalog.Substats.ToDictionary(item => item.Value);
    private static readonly IReadOnlyDictionary<ScoringProfileId, CatalogItem<ScoringProfileId>> ProfilesById =
        RelicCatalog.Profiles.ToDictionary(item => item.Value);
    private static readonly IReadOnlyDictionary<RelicSlot, CatalogItem<RelicSlot>> SlotsById =
        RelicCatalog.Slots.ToDictionary(item => item.Value);

    private CalculatorInput _input = CalculatorInput.CreateDefault();
    private ScoreSubmissionResponse? _submission;
    private RelicImportResponse? _importResult;
    private readonly List<ScoredImportedRelic> _batchScores = [];
    private ScoringProfileId? _resultProfile;
    private readonly List<string> _messages = [];
    private string _uid = string.Empty;
    private string? _selectedRelicKey;
    private string? _importError;
    private string? _importStatus;
    private bool _isImporting;
    private bool _isBatchScoring;
    private bool _isCalculating;
    private string? _copyMessage;
    private bool IsImportBusy => _isImporting || _isBatchScoring;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var saved = await JavaScript.InvokeAsync<string?>("localStorage.getItem", StorageKey);
        if (!string.IsNullOrWhiteSpace(saved))
        {
            try
            {
                var restored = System.Text.Json.JsonSerializer.Deserialize<PersistedState>(saved, JsonOptions);
                if (!IsValidPersistedState(restored))
                {
                    throw new System.Text.Json.JsonException("저장된 계산 형식이 올바르지 않습니다.");
                }

                _input = restored!.Input;
                _submission = restored.Submission;
                _resultProfile = restored.Profile;
            }
            catch (System.Text.Json.JsonException)
            {
                _input = CalculatorInput.CreateDefault();
                _submission = null;
                _resultProfile = null;
                _messages.Add("손상된 이전 입력을 초기화했습니다.");
                await JavaScript.InvokeVoidAsync("localStorage.removeItem", StorageKey);
            }

            StateHasChanged();
        }
    }

    private async Task ImportUidAsync()
    {
        if (IsImportBusy)
        {
            return;
        }

        var uid = _uid.Trim();
        if (uid.Length != 9 || uid.Any(character => !char.IsAsciiDigit(character)))
        {
            _importError = "UID는 숫자 9자리로 입력해 주세요.";
            return;
        }

        _isImporting = true;
        _importError = null;
        _importStatus = null;

        try
        {
            using var response = await Http.GetAsync($"api/import/uid/{uid}");
            if (!response.IsSuccessStatusCode)
            {
                _importError = await ReadApiErrorAsync(response);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<RelicImportResponse>(JsonOptions);
            SetImportResult(result);
        }
        catch (HttpRequestException)
        {
            _importError = "계산 서버에 연결하지 못했습니다. API 실행 상태를 확인해 주세요.";
        }
        catch (System.Text.Json.JsonException)
        {
            _importError = "공개 프로필 응답 형식을 읽지 못했습니다.";
        }
        finally
        {
            _isImporting = false;
        }
    }

    private async Task ImportScannerJsonAsync(InputFileChangeEventArgs eventArgs)
    {
        if (IsImportBusy)
        {
            return;
        }

        const long maximumFileBytes = 10 * 1024 * 1024;
        _importError = null;
        _importStatus = null;

        if (eventArgs.File.Size > maximumFileBytes)
        {
            _importError = "JSON 파일은 10MB 이하여야 합니다.";
            return;
        }

        _isImporting = true;
        try
        {
            await using var stream = eventArgs.File.OpenReadStream(maximumFileBytes);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            using var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            using var response = await Http.PostAsync("api/import/scanner", content);
            if (!response.IsSuccessStatusCode)
            {
                _importError = await ReadApiErrorAsync(response);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<RelicImportResponse>(JsonOptions);
            SetImportResult(result);
        }
        catch (IOException)
        {
            _importError = "선택한 JSON 파일을 읽지 못했습니다.";
        }
        catch (HttpRequestException)
        {
            _importError = "계산 서버에 연결하지 못했습니다. API 실행 상태를 확인해 주세요.";
        }
        catch (System.Text.Json.JsonException)
        {
            _importError = "HSR Scanner JSON 응답 형식을 읽지 못했습니다.";
        }
        finally
        {
            _isImporting = false;
        }
    }

    private void SetImportResult(RelicImportResponse? result)
    {
        if (result is null)
        {
            _importError = "불러오기 결과를 읽지 못했습니다.";
            return;
        }

        _importResult = result;
        _selectedRelicKey = result.Relics.FirstOrDefault()?.Key;
        _batchScores.Clear();
        _importStatus = result.Relics.Count > 0
            ? $"5성 유물 {result.Relics.Count}개를 불러왔습니다."
            : "가져올 수 있는 5성 유물이 없습니다.";
    }

    private void ApplySelectedRelic()
    {
        if (IsImportBusy)
        {
            return;
        }

        var relic = _importResult?.Relics.FirstOrDefault(item => item.Key == _selectedRelicKey);
        if (relic is null)
        {
            _importError = "적용할 유물을 선택해 주세요.";
            return;
        }

        ApplyImportedRelic(relic);
    }

    private void ApplyImportedRelic(ImportedRelic relic)
    {
        _input.Level = relic.Level;
        _input.Slot = relic.Slot;
        _input.MainStat = relic.MainStat;
        _input.Substats = relic.Substats
            .Select(substat => new SubstatInput { Stat = substat.Stat, Value = substat.Value })
            .ToList();

        foreach (var stat in RelicCatalog.Substats)
        {
            if (_input.Substats.Count >= 4)
            {
                break;
            }

            if (_input.Substats.All(row => row.Stat != stat.Value))
            {
                _input.Substats.Add(new SubstatInput { Stat = stat.Value });
            }
        }

        _submission = null;
        _resultProfile = null;
        _messages.Clear();
        _copyMessage = null;
        _importError = null;
        _importStatus = $"{RelicLabel(relic)} 정보를 입력칸에 적용했습니다.";
    }

    private async Task CalculateImportedRelicsAsync()
    {
        if (IsImportBusy)
        {
            return;
        }

        if (_importResult?.Relics.Count is not > 0)
        {
            _importError = "먼저 유물을 불러와 주세요.";
            return;
        }

        _isBatchScoring = true;
        _importError = null;
        _batchScores.Clear();
        var profile = _input.Profile;
        var relics = _importResult.Relics.ToArray();

        try
        {
            foreach (var relicChunk in relics.Chunk(300))
            {
                var request = new RelicBatchScoreRequest(profile, relicChunk);
                using var response = await Http.PostAsJsonAsync("api/scores/batch", request, JsonOptions);
                if (!response.IsSuccessStatusCode)
                {
                    _importError = await ReadApiErrorAsync(response);
                    _batchScores.Clear();
                    return;
                }

                var scores = await response.Content.ReadFromJsonAsync<List<ScoredImportedRelic>>(JsonOptions);
                if (scores is null)
                {
                    _importError = "일괄 계산 결과를 읽지 못했습니다.";
                    _batchScores.Clear();
                    return;
                }

                _batchScores.AddRange(scores);
            }

            var sortedScores = _batchScores
                .OrderByDescending(score => score.Result.IsValid)
                .ThenByDescending(score => score.Result.Score)
                .ToArray();
            _batchScores.Clear();
            _batchScores.AddRange(sortedScores);
            _importStatus = $"{ProfilesById[profile].Name} 기준으로 {_batchScores.Count}개를 계산했습니다.";
        }
        catch (HttpRequestException)
        {
            _importError = "계산 서버에 연결하지 못했습니다. API 실행 상태를 확인해 주세요.";
            _batchScores.Clear();
        }
        catch (System.Text.Json.JsonException)
        {
            _importError = "일괄 계산 응답 형식을 읽지 못했습니다.";
            _batchScores.Clear();
        }
        finally
        {
            _isBatchScoring = false;
        }
    }

    private static async Task<string> ReadApiErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var error = await response.Content.ReadFromJsonAsync<ApiError>(JsonOptions);
            return string.IsNullOrWhiteSpace(error?.Message)
                ? $"서버가 {(int)response.StatusCode} 오류를 반환했습니다."
                : error.Message;
        }
        catch (System.Text.Json.JsonException)
        {
            return $"서버가 {(int)response.StatusCode} 오류를 반환했습니다.";
        }
    }

    private static string RelicLabel(ImportedRelic relic)
    {
        var equipped = string.IsNullOrWhiteSpace(relic.EquippedBy) ? "미장착" : relic.EquippedBy;
        return $"{relic.SetName} · {SlotsById[relic.Slot].Name} +{relic.Level} · {equipped}";
    }

    private static string SubstatSummary(ImportedRelic relic) => string.Join(
        " · ",
        relic.Substats.Select(substat =>
            $"{StatsById[substat.Stat].Name} {substat.Value:0.##}{StatsById[substat.Stat].Unit}"));

    private async Task CalculateAsync()
    {
        _isCalculating = true;
        _messages.Clear();
        _copyMessage = null;

        try
        {
            var substats = _input.Substats
                .Where(row => row.Value.HasValue)
                .Select(row => new RelicSubstat(row.Stat, row.Value!.Value))
                .ToArray();
            var request = new ScoreRequest(
                _input.Profile,
                _input.Level,
                substats,
                _input.Slot,
                _input.MainStat);
            var response = await Http.PostAsJsonAsync("api/scores", request, JsonOptions);
            _submission = await response.Content.ReadFromJsonAsync<ScoreSubmissionResponse>(JsonOptions);

            if (_submission is null)
            {
                _messages.Add("서버 응답을 읽지 못했습니다.");
            }
            else if (!_submission.Result.IsValid)
            {
                _messages.AddRange(_submission.Result.Errors);
                _submission = null;
                _resultProfile = null;
            }
            else
            {
                _resultProfile = request.Profile;
                var persistedState = new PersistedState(_input, _submission, _resultProfile.Value);
                var json = System.Text.Json.JsonSerializer.Serialize(persistedState, JsonOptions);
                await JavaScript.InvokeVoidAsync("localStorage.setItem", StorageKey, json);
            }
        }
        catch (HttpRequestException)
        {
            _messages.Add("계산 서버에 연결하지 못했습니다. API 실행 상태를 확인해 주세요.");
            _submission = null;
            _resultProfile = null;
        }
        catch (System.Text.Json.JsonException)
        {
            _messages.Add("계산 서버의 응답 형식을 읽지 못했습니다.");
            _submission = null;
            _resultProfile = null;
        }
        finally
        {
            _isCalculating = false;
        }
    }

    private async Task ResetAsync()
    {
        _input = CalculatorInput.CreateDefault();
        _submission = null;
        _resultProfile = null;
        _messages.Clear();
        _copyMessage = null;
        await JavaScript.InvokeVoidAsync("localStorage.removeItem", StorageKey);
    }

    private void UpdateMainStatOptions()
    {
        var availableMainStats = RelicCatalog.MainStatsFor(_input.Slot);
        if (availableMainStats.All(item => item.Value != _input.MainStat))
        {
            _input.MainStat = availableMainStats[0].Value;
        }
    }

    private async Task CopyResultAsync()
    {
        if (_submission is null)
        {
            return;
        }

        var text = $"붕괴: 스타레일 유물 점수 | {ProfilesById[_resultProfile!.Value].Name} | {_submission.Result.Grade} 등급 {_submission.Result.Score:0.0}점";
        await JavaScript.InvokeVoidAsync("navigator.clipboard.writeText", text);
        _copyMessage = "결과를 클립보드에 복사했습니다.";
    }

    private static bool IsValidPersistedState(PersistedState? state)
    {
        if (state?.Input?.Substats is not { Count: 4 }
            || state.Submission?.Result is not { IsValid: true }
            || !Enum.IsDefined(state.Profile)
            || !Enum.IsDefined(state.Input.Profile)
            || !Enum.IsDefined(state.Input.Slot)
            || !Enum.IsDefined(state.Input.MainStat)
            || state.Input.Level is < 0 or > 15
            || state.Input.Profile != state.Profile
            || state.Input.Substats.Any(row => row is null)
            || state.Input.Substats.Any(row => !Enum.IsDefined(row.Stat))
            || state.Submission.Result.Grade is not ("C" or "B" or "A" or "S" or "SS" or "SSS")
            || state.Submission.Result.Contributions is null
            || state.Submission.Result.Contributions.Any(contribution => contribution is null)
            || state.Submission.Result.Contributions.Any(contribution => !Enum.IsDefined(contribution.Stat))
            || state.Submission.Result.Contributions.Count != state.Input.Substats.Count(row => row.Value.HasValue)
            || state.Submission.Result.Score != state.Submission.Result.Contributions.Sum(contribution => contribution.Score))
        {
            return false;
        }

        return RelicCatalog.MainStatsFor(state.Input.Slot)
            .Any(item => item.Value == state.Input.MainStat);
    }

    private sealed class CalculatorInput
    {
        public ScoringProfileId Profile { get; set; } = ScoringProfileId.Critical;
        public int Level { get; set; } = 15;
        public RelicSlot Slot { get; set; } = RelicSlot.Head;
        public RelicMainStat MainStat { get; set; } = RelicMainStat.FlatHp;
        public List<SubstatInput> Substats { get; set; } = [];

        public static CalculatorInput CreateDefault() => new()
        {
            Substats =
            [
                new() { Stat = RelicStat.CritRate },
                new() { Stat = RelicStat.CritDamage },
                new() { Stat = RelicStat.Speed },
                new() { Stat = RelicStat.AttackPercent }
            ]
        };
    }

    private sealed class SubstatInput
    {
        public RelicStat Stat { get; set; }
        public decimal? Value { get; set; }
    }

    private sealed record ScoreSubmissionResponse(
        ScoreResult Result,
        bool RedisSaved,
        string? Warning);

    private sealed record PersistedState(
        CalculatorInput Input,
        ScoreSubmissionResponse Submission,
        ScoringProfileId Profile);

    private sealed record ApiError(string Message);
}
